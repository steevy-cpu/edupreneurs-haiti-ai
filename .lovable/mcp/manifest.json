{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://xdyavylcmucjpueybdku.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "edupreneurs-haiti-ai",
      "version": "0.1.0",
      "title": "edupreneurs-haiti-ai"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Get the signed-in student's profile: name, academic grade, gold earned, streak and exam stats.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_subjects",
        "title": "List subjects",
        "description": "List the school subjects (matières) available on Edupreneurs, optionally filtered by academic grade code (7AF, 8AF, 9AF, NS1-NS4).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "grade_level": {
              "type": "string",
              "description": "Academic grade code, e.g. 9AF or NS4. Omit for all grades."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_lessons",
        "title": "List lessons",
        "description": "List published lessons, optionally filtered by subject id, academic grade, or a title search term.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "subject_id": {
              "type": "string",
              "format": "uuid",
              "description": "Subject id from list_subjects."
            },
            "grade_level": {
              "type": "string",
              "description": "Academic grade code, e.g. NS2."
            },
            "search": {
              "type": "string",
              "minLength": 1,
              "description": "Search text matched against lesson titles."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max lessons to return (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_lesson",
        "title": "Get lesson",
        "description": "Get the full text of one published lesson by its slug: objective, introduction, content and worked examples.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Lesson slug from list_lessons."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_completed_lessons",
        "title": "List my completed lessons",
        "description": "List the lessons the signed-in student has completed, most recent first, with their quiz scores.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max rows to return (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_word_of_the_day",
        "title": "Get word of the day",
        "description": "Get the current active 'Mot du Jour' vocabulary word with its phonetic, definition and example sentence.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
